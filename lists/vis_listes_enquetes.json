            "debug": "true",
            "sql": "SELECT dp.c_npi, dp.c_nom, dp.c_prenom, dp.c_pid, dp.c_statut_demande, dp.c_compagne_enquete , dp.c_adresse\nFROM app_fd_planif_enquete pf, app_fd_d_preinscription dp\nWHERE (pf.c_compagne_enquete = dp.c_compagne_enquete)\nAND ((pf.c_chef_equipe = '#currentUser.username#') OR (pf.c_equipe_enquete LIKE '%#currentUser.username#%'))\nAND (dp.c_pid = '#requestParam.pid#')\n",
