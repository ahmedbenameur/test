        {
            "className": "org.joget.BshAction",
            "id": "action_1",
            "properties": {
                "label": "Attribuer à la liste des Vulnérables au choc",
                "datalist_type": "action",
                "script": "import java.sql.Connection;\r\nimport java.sql.PreparedStatement;\r\nimport java.sql.ResultSet;\r\nimport java.sql.SQLException;\r\nimport javax.sql.DataSource;\r\nimport org.joget.apps.app.service.AppUtil;    \r\nimport org.joget.apps.app.service.*;\r\nimport org.joget.apps.form.model.*;\r\nimport org.joget.apps.form.service.*;\r\nimport org.joget.apps.form.model.FormData;\r\nimport java.sql.*;\r\nimport java.util.*;\r\nimport org.joget.commons.util.LogUtil;\r\nfor (String key : rowKeys) {\r\n//---------------------------------- Update DB ----------------------------------------\r\nConnection con = null;\r\ntry {\r\n    DataSource ds = (DataSource) AppUtil.getApplicationContext().getBean(\"setupDataSource\");\r\n    con = ds.getConnection();\r\n    if (con != null && !con.isClosed()) {\r\n        LogUtil.warn(\"------------------------------>Connection Open\",\"<--------------------\");\r\n        String updateQuery = \"UPDATE app_fd_d_preinscription SET c_statut_vulnerabilite = ? WHERE id = ?\";\r\n        PreparedStatement updateStatement = con.prepareStatement(updateQuery);\r\n        updateStatement.setString(1, \"Vulnérable au choc\");\r\n        updateStatement.setString(2, key);\r\n        updateStatement.executeUpdate();\r\n        LogUtil.warn(\"------------------------------>Record updated successfully\",\"<-------------\");\r\n    }\r\n} catch (Exception ex) {\r\n    LogUtil.error(\"Error: \", ex,\"------\");\r\n} finally {\r\n    try {\r\n        if (con != null)\r\n            con.close();\r\n        LogUtil.warn(\"------------------------------>Connection Closed\",\"<---\");\r\n    } catch (SQLException e) {\r\n        LogUtil.error(\"Error closing connection: \", e,\"----\");\r\n    }\r\n}\r\n}",
                "confirmationMessage": ""
            }
        },
