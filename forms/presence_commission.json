                                "value": "<!-- Include SweetAlert2 Library -->\r\n<script src=\"https://cdn.jsdelivr.net/npm/sweetalert2@11\"><\/script>\r\n\r\n<script>\r\n    $(document).ready(function () {\r\n       \r\n\r\n        if (\"#variable.quorum#\"==\"false\") {\r\n            console.log(\"----------------->\",\"#variable.quorum#\");\r\n            try {\r\n                // Parse the error messages from the JSON string\r\n      \r\n                  \r\n                        Swal.fire({\r\n                            title: 'Erreur lors de la validation communautaire',\r\n                            html: 'Il faut qu\\'au moins trois personnes soient présentes pour continuer la validation communautaire', // Format messages as HTML\r\n                            icon: 'error',\r\n                            showCancelButton: true,  // Enables the \"Annuler\" button\r\n                            confirmButtonText: 'Reporter la commission',\r\n                            cancelButtonText: 'Annuler' // Custom text for cancel button\r\n                        }).then((result) => {\r\n                            if (result.isConfirmed) {\r\n                            \r\n                             \r\n                                document.getElementById(\"validator_members\").value='true';\r\n                              setTimeout(() => {\r\n                            document.getElementById(\"assignmentComplete\").click();\r\n                        }, 1000);\r\n\r\n                            \r\n                            }else{\r\n                                Swal.close();\r\n\r\n                            }\r\n                        });\r\n                    \r\n                \r\n            } catch (err) {\r\n                console.error(\"Error parsing _FORM_ERRORS:\", err);\r\n            }\r\n        }\r\n    });\r\n<\/script>\r\n<style>\r\n    #validator_members{\r\n        display:none;\r\n    }\r\n<\/style>\r\n"
