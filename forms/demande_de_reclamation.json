                        {
                            "className": "org.joget.apps.form.lib.CustomHTML",
                            "properties": {
                                "requiredSanitize": "",
                                "autoPopulate": "",
                                "label": "",
                                "id": "field18",
                                "value": "<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/css/intlTelInput.css\" />\r\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/intlTelInput.min.js\"><\/script>\r\n<script>\r\n  $(document).ready(function(){\r\n    const fields = [\"num_contacter\", \"num_deposant\"]; // List of input field IDs\r\n\r\nfields.forEach((fieldId) => {\r\n    const input = document.querySelector(`#${fieldId}`);\r\n    const countryCode1=document.getElementById('country_code_num_1').value;\r\n    const countryCode2=document.getElementById('country_code_num_2').value;\r\n    countryCodeSetup=\"\";\r\n    if(fieldId==\"num_contacter\"){\r\n        countryCodeSetup=countryCode1!=''?countryCode1:'BJ';\r\n    }else{\r\n        countryCodeSetup=countryCode2!=''?countryCode1:'BJ';\r\n    }\r\n    const iti = window.intlTelInput(input, {\r\n        initialCountry: countryCodeSetup, // Set default country to Benin\r\n        geoIpLookup: function (callback) {\r\n            // Fallback to Benin if geo-detection is not required or fails\r\n            callback(\"BJ\");\r\n        },\r\n        utilsScript: \"https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/utils.js\", // Required for formatting\r\n    });\r\n    input.addEventListener('countrychange', () => {\r\n            const countryData = iti.getSelectedCountryData(); // Get the selected country data\r\n            input.value=\"\";\r\n            input.value=countryData.dialCode+' ';\r\n            if(fieldId==\"num_contacter\"){\r\n               document.getElementById('country_code_num_1').value=countryData.iso2;\r\n            }else{\r\n                document.getElementById('country_code_num_2').value=countryData.iso2;\r\n            }\r\n            console.log(`Field: ${fieldId}`);\r\n            console.log(`Country Name: ${countryData.name}`);\r\n            console.log(`Country Code: ${countryData.iso2}`);\r\n            console.log(`Dial Code: +${countryData.dialCode}`);\r\n        });\r\n\r\n    // Example: Get the full phone number on input change\r\n    input.addEventListener('blur', () => {\r\n        // input.value=\"\";\r\n            // input.value=countryData.dialCode+' ';\r\n            // if(fieldId==\"num_contacter\"){\r\n            //   document.getElementById('country_code_num_1').value=countryData.iso2;\r\n            // }else{\r\n            //     document.getElementById('country_code_num_2').value=countryData.iso2;\r\n            // }\r\n        const fullNumber = iti.getNumber(); // Get the full number in E.164 format\r\n        console.log(`${fieldId} Full Number: `, fullNumber);\r\n    });\r\n    \r\n});\r\n  })\r\n<\/script>\r\n<style>\r\n       #npi {\r\n            filter: blur(5px); /* Apply blur effect */\r\n            transition: filter 0.3s ease; /* Smooth transition when blurring/unblurring */\r\n            cursor: pointer;\r\n        }\r\n\r\n        #npi:hover {\r\n            filter: none; /* Remove blur on hover or focus */\r\n            cursor: text;\r\n        }\r\n<\/style>\r\n"
                            }
