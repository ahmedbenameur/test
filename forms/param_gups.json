        "postProcessor": {
            "className": "org.joget.apps.app.lib.BeanShellTool",
            "properties": {"script": "import org.joget.directory.model.Department;\r\nimport org.joget.directory.model.Organization;\r\nimport org.joget.directory.dao.OrganizationDao;\r\nimport org.joget.directory.dao.DepartmentDao;\r\nimport org.joget.directory.model.service.DirectoryManager;\r\nimport org.joget.apps.app.service.AppUtil;\r\nimport org.joget.commons.util.LogUtil;\r\nimport java.lang.string;\r\n\r\nDirectoryManager directoryManager = (DirectoryManager) AppUtil.getApplicationContext().getBean(\"directoryManager\");\r\nString subDeptId = \"#form.param_gups.subDeptId#\";\r\nString subDeptName = \"#form.param_gups.subDeptName#\";\r\nString parentDeptId = \"#form.param_gups.parentDeptId#\";\r\nString orgId = \"#form.param_gups.orgId#\";\r\ntry {\r\n    DepartmentDao departmentDao = (DepartmentDao) AppUtil.getApplicationContext().getBean(\"departmentDao\");\r\n    Department parentDepartment = departmentDao.getDepartment(parentDeptId);\r\n    if (parentDepartment == null) {\r\n        LogUtil.error(\"BeanShell\", null, \"Parent department not found for ID: \" + parentDeptId);\r\n        return null;\r\n    }\r\n    OrganizationDao organizationDao = (OrganizationDao) AppUtil.getApplicationContext().getBean(\"organizationDao\");\r\n    Organization organization = organizationDao.getOrganization(orgId);\r\n    if (organization == null) {\r\n        LogUtil.error(\"BeanShell\", null, \"Organization not found for ID: \" + orgId);\r\n        return null;\r\n    }\r\n    Department subDepartment = new Department();\r\n    subDepartment.setId(subDeptId);\r\n    subDepartment.setName(subDeptName);\r\n    subDepartment.setOrganization(organization);\r\n    subDepartment.setParent(parentDepartment);\r\n    boolean isSaved = departmentDao.addDepartment(subDepartment);\r\n    if (isSaved) {\r\n        LogUtil.info(\"BeanShell\", \"Sub-department \" + subDeptName + \" created successfully under \" + parentDepartment.getName());\r\n    } else {\r\n        LogUtil.error(\"BeanShell\", null, \"Failed to create sub-department \" + subDeptName);\r\n    }\r\n} catch (Exception e) {\r\n    LogUtil.error(\"BeanShell\", e, \"Error creating sub-department.\");\r\n}\r\n"}
        },
