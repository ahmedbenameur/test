                                "label": "",
                                "id": "field15",
                                "value": "<script>\n   $(document).ready(function(){\n    \n    try{\n            console.log(\"checking departements----------------\",\"#variable.evaluation_users#\");\n        //   #user.username.department.id#\n          \n        if(('#currentUser.username#').includes('#variable.evaluation_users#')){\n        \n        document.getElementById('section-actions').style.display='none';\n    } \n    }catch(x){\n        \n    }\n    try{\n            document.getElementById('delai').addEventListener('keydown', function (event) {\n            event.preventDefault(); // Block any key press\n        });\n    }catch(x){\n        \n    }\n    try{\n           var selectedDelai=document.getElementsByName('gravite_reclamation')[0];\n         selectedDelai.addEventListener('change',function(){\n\n          console.log(\"GRAVITE----------------\",selectedDelai.value);\n        \n          if(selectedDelai.value=='Faible' || selectedDelai.value=='Moyenne'){\n                 document.getElementById('delai').value=\"\";\n             document.getElementById('delai').setAttribute('type', 'number');\n             document.getElementById('delai').setAttribute('max', '10');\n             document.getElementById('delai').setAttribute('min', '0');\n          }else{\n               document.getElementById('delai').value=\"\";\n             document.getElementById('delai').setAttribute('type', 'number');\n             document.getElementById('delai').setAttribute('max', '30');\n             document.getElementById('delai').setAttribute('min', '0');\n          }\n        \n   })\n    }catch(x){\n        console.error(x);\n    }\n      \n   })\n\n<\/script>"
                            }
